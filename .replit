modules = ["python-3.12", "web", "nodejs-20", "nix"]
run = "python main.py"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "python main.py"]

[workflows]
runButton = "Run"

[[workflows.workflow]]
name = "Run"
author = 40447242
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd DrugInfoAPI/DrugInfoAPI && python main.py"

[[ports]]
localPort = 5000
externalPort = 80
